# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored. Never commit real contact details.

# Public origin of the deployed site, with no trailing slash.
# Powers canonical URLs, the sitemap, robots.txt and Open Graph previews.
# Falls back to a placeholder domain if unset, so set this after first deploy.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional. Contact address shown on the Contact section.
# Left unset, the email button is hidden and only the GitHub link is shown.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Optional. Full LinkedIn profile URL. Left unset, the LinkedIn link is hidden.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
